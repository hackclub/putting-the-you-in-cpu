---
import { getCollection, type CollectionEntry } from 'astro:content'

export interface Props {
	chapterSlug: CollectionEntry<'chapters'>['id']
}

const { chapterSlug } = Astro.props
const allChapters = await getCollection('chapters')
---

<details class='old-nav'>
	<summary>All Chapters</summary>

	<ol start='0'>
		<li>
			<a href='/'>Intro</a>
		</li>
		{allChapters
			.filter(chapter => chapter.data.chapter !== 0) // Skip the intro
			.map(otherChapter => (
				<li class={otherChapter.id === chapterSlug ? 'active' : ''}>
					<a href={otherChapter.id} aria-current={otherChapter.id === chapterSlug ? 'page' : undefined}>
						{otherChapter.data.title}
					</a>
				</li>
			))
		}
	</ol>
</details>